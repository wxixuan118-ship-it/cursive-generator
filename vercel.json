{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cursive-text-generator.net"
        }
      ],
      "destination": "https://www.cursive-text-generator.net/:path*",
      "permanent": true
    },
    {
      "source": "/cursive-text-generator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cursive-text-generator.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cursive-fonts",
      "destination": "/cursive-fonts.html",
      "permanent": true
    },
    {
      "source": "/cursive-alphabet",
      "destination": "/cursive-alphabet.html",
      "permanent": true
    },
    {
      "source": "/cursive-name-generator",
      "destination": "/cursive-name-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-name-generator/",
      "destination": "/cursive-name-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-signature-generator",
      "destination": "/cursive-signature-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-signature-generator/",
      "destination": "/cursive-signature-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-name-tracing-generator",
      "destination": "/cursive-name-tracing-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-name-tracing-generator/",
      "destination": "/cursive-name-tracing-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-name-practice-generator",
      "destination": "/cursive-name-practice-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-name-practice-generator/",
      "destination": "/cursive-name-practice-generator.html",
      "permanent": true
    },
    {
      "source": "/fancy-text-generator",
      "destination": "/fancy-text-generator.html",
      "permanent": true
    },
    {
      "source": "/cursive-bold-generator",
      "destination": "/cursive-bold-generator.html",
      "permanent": true
    },
    {
      "source": "/calligraphy-text-generator",
      "destination": "/calligraphy-text-generator.html",
      "permanent": true
    },
    {
      "source": "/handwriting-font-generator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cursive-letters-a-z",
      "destination": "/cursive-letters-a-z.html",
      "permanent": true
    },
    {
      "source": "/cursive-letters-generator",
      "destination": "/cursive-letters-generator.html",
      "permanent": true
    },
    {
      "source": "/free-commercial-cursive-fonts",
      "destination": "/cursive-fonts.html",
