# Caddyfile for cursive-text-generator.net
# Handles www/non-www redirect and URL consolidation

# Redirect non-www to www
cursive-text-generator.net {
  redir https://www.cursive-text-generator.net{uri} permanent
}

# Main domain
www.cursive-text-generator.net {
  # Serve from public directory
  root * /public
  file_server

  # ─── URL Consolidation (301 redirects) ───
  # Every legacy directory-style URL (bare / trailing-slash / index.html)
  # 301s to its canonical flat .html page. Kept in sync with public/_redirects.

  # Homepage variants
  # NOTE: /cursive-text-generator.html is a REAL landing page targeting the main
  # keyword "cursive text generator"; the homepage / targets "cursive generator".
  # Never redirect /cursive-text-generator.html away.
  redir /index.html / permanent
  @ctgdir path /cursive-text-generator /cursive-text-generator/ /cursive-text-generator/index.html
  redir @ctgdir /cursive-text-generator.html permanent

  # Navigation category labels -> primary tool
  @letters path /letters /letters/ /letters/index.html
  redir @letters /cursive-letters-generator.html permanent
  @names path /names /names/ /names/index.html
  redir @names /cursive-name-generator.html permanent
  @fonts path /fonts /fonts/ /fonts/index.html
  redir @fonts /cursive-fonts.html permanent
  @worksheets path /worksheets /worksheets/ /worksheets/index.html
  redir @worksheets /cursive-practice-sheets.html permanent

  # Legacy directory-style tool pages removed 2026-08-28 -> flat .html
  @conv path /cursive-converter /cursive-converter/ /cursive-converter/index.html
  redir @conv /cursive-converter.html permanent
  @compat path /cursive-compatibility /cursive-compatibility/ /cursive-compatibility/index.html
  redir @compat /cursive-compatibility.html permanent
  @nameg path /cursive-name-generator /cursive-name-generator/ /cursive-name-generator/index.html
  redir @nameg /cursive-name-generator.html permanent
  @namep path /cursive-name-practice-generator /cursive-name-practice-generator/ /cursive-name-practice-generator/index.html
  redir @namep /cursive-name-practice-generator.html permanent
  @namet path /cursive-name-tracing-generator /cursive-name-tracing-generator/ /cursive-name-tracing-generator/index.html
  redir @namet /cursive-name-tracing-generator.html permanent
  @sheets path /cursive-practice-sheets /cursive-practice-sheets/ /cursive-practice-sheets/index.html
  redir @sheets /cursive-practice-sheets.html permanent
  @sig path /cursive-signature-generator.html /cursive-signature-generator /cursive-signature-generator/ /cursive-signature-generator/index.html
  redir @sig /copy-and-paste-cursive-signature.html permanent
  @boldfont path /cursive-bold-font-generator /cursive-bold-font-generator/ /cursive-bold-font-generator/index.html
  redir @boldfont /cursive-bold-generator.html permanent

  # Legacy copy-and-paste directory pages -> flat .html (hub /copy-and-paste/ stays)
  @cpfont path /copy-and-paste/cursive-font /copy-and-paste/cursive-font/ /copy-and-paste/cursive-font/index.html
  redir @cpfont /copy-and-paste-cursive-font.html permanent
  @cpsig path /copy-and-paste/cursive-signature /copy-and-paste/cursive-signature/ /copy-and-paste/cursive-signature/index.html
  redir @cpsig /copy-and-paste-cursive-signature.html permanent
  @cpwrite path /copy-and-paste/cursive-writing /copy-and-paste/cursive-writing/ /copy-and-paste/cursive-writing/index.html
  redir @cpwrite /copy-and-paste-cursive-writing.html permanent

  # Bare (extensionless) pretty URLs -> flat .html
  redir /cursive-fonts /cursive-fonts.html permanent
  redir /cursive-alphabet /cursive-alphabet.html permanent
  redir /cursive-letters-a-z /cursive-letters-a-z.html permanent
  redir /cursive-letters-generator /cursive-letters-generator.html permanent
  redir /fancy-text-generator /fancy-text-generator.html permanent
  redir /cursive-bold-generator /cursive-bold-generator.html permanent
  redir /calligraphy-text-generator /calligraphy-text-generator.html permanent
  @freefonts path /free-commercial-cursive-fonts /free-commercial-cursive-fonts.html
  redir @freefonts /cursive-fonts.html permanent
  redir /handwriting-font-generator / permanent

  # ─── Handle 404s ───
  error /404.html 404

  # ─── Enable gzip compression ───
  encode gzip

  # ─── Security headers ───
  header / {
    X-Frame-Options "SAMEORIGIN"
    X-Content-Type-Options "nosniff"
    X-XSS-Protection "1; mode=block"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }

  # ─── Cache control ───
  # Cache static assets for 30 days
  header /assets/* {
    Cache-Control "public, max-age=2592000, immutable"
  }
  header /extension/* {
    Cache-Control "public, max-age=86400"
  }

  # HTML pages: cache 1 day (for sitemaps, etc.)
  header *.html {
    Cache-Control "public, max-age=86400, must-revalidate"
  }

  # ─── Enable HTTP/2 Server Push (optional) ───
  # push /assets/styles.css
  # push /assets/script.js
}
